# Copiar a /etc/cd-receiver/receiver.env en el servidor (chmod 600, root:root).

# Secreto compartido con GitHub. Generalo con:  openssl rand -hex 32
# Debe ser identico al configurado en Settings > Webhooks del repositorio.
WEBHOOK_SECRET=cambia-esto-por-32-bytes-hex-de-openssl-rand

# Inventario de apps y directorios de trabajo.
APPS_FILE=/etc/cd-receiver/apps.yml
STATE_DIR=/var/lib/cd-receiver
LOG_DIR=/var/log/cd-receiver

# API de Docker via socket-proxy (ADR-0005). Nunca unix:///var/run/docker.sock:
# eso exigiria devolver el usuario al grupo docker.
DOCKER_HOST=tcp://127.0.0.1:2375

# El receptor solo escucha en loopback: quien lo publica es el tunel.
BIND_HOST=127.0.0.1
BIND_PORT=9000

# Opcional: permite consultar /status y /reload desde fuera del servidor.
# Sin este valor, ambos endpoints solo responden a 127.0.0.1.
# STATUS_TOKEN=

LOG_LEVEL=INFO
